# Environment
NODE_ENV=development
PORT=3000

# PostgreSQL connection (Prisma manages pooling)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://himma:himma_secret@localhost:5432/himma?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Anthropic API (server-side only — never expose in frontend)
ANTHROPIC_API_KEY=

# CORS — your custom domain in production, e.g. https://himma.example.com
CORS_ORIGIN=*

# Behind reverse proxy (nginx, Caddy, Railway, etc.)
TRUST_PROXY=false

# Logging
LOG_LEVEL=info

# Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Optional: upload backups to S3-compatible storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_S3_REGION=
